          "name": { "ko": "작업표시줄 아이콘", "en": "Taskbar icon", "ja": "タスクバーのアイコン", "zh": "任务栏图标" },
          "easy": {
            "name": { "ko": "아이콘 모양", "en": "Icon look", "ja": "アイコンの形", "zh": "图标样式" },
            "about": { "ko": "숫자는 지금 쓰는 양입니다", "en": "The number is what is in use now", "ja": "数字は今使っている量です", "zh": "数字是当前的使用量" }
          }
        },
        {
          "key": "widget.show",
          "type": "choice",
          "file": "prefs.json",
          "field": "show",
          "default": 0,
          "options": [
            {
              "value": 0,
              "name": { "ko": "메모리", "en": "Memory", "ja": "メモリ", "zh": "内存" },
              "easy": {
                "name": { "ko": "메모리", "en": "Memory", "ja": "メモリ", "zh": "内存" },
                "picture": {
                  "shapes": [
                    { "text": "62%", "at": [36, 18], "size": 13, "fill": "accent" },
                    {
                      "text": { "ko": "메모리", "en": "Memory", "ja": "メモリ", "zh": "内存" },
                      "at": [36, 31],
                      "size": 7.5,
                      "bold": false,
                      "alpha": 0.75
                    }
                  ]
                }
              }
            },
            {
              "value": 1,
              "name": { "ko": "CPU", "en": "CPU", "ja": "CPU", "zh": "CPU" },
              "easy": {
                "name": { "ko": "CPU", "en": "CPU" },
                "picture": {
                  "shapes": [
                    { "text": "12%", "at": [36, 18], "size": 13, "fill": "accent" },
                    { "text": "CPU", "at": [36, 31], "size": 7.5, "bold": false, "alpha": 0.75 }
                  ]
                }
              }
            },
            {
              "value": 2,
              "name": { "ko": "메모리+CPU", "en": "Memory+CPU", "ja": "メモリ+CPU", "zh": "内存+CPU" },
              "easy": {
                "name": { "ko": "둘 다", "en": "Both", "ja": "両方", "zh": "两者" },
                "picture": {
                  "shapes": [
                    { "text": "62%", "at": [21, 18], "width": 30, "size": 11.5, "fill": "accent" },
                    {
                      "text": { "ko": "메모리", "en": "Memory", "ja": "メモリ", "zh": "内存" },
                      "at": [21, 31],
                      "width": 30,
                      "size": 7,
                      "bold": false,
                      "alpha": 0.75
                    },
                    { "text": "12%", "at": [51, 18], "width": 30, "size": 11.5, "fill": "accent" },
                    { "text": "CPU", "at": [51, 31], "width": 30, "size": 7, "bold": false, "alpha": 0.75 }
                  ]
                }
              }
            }
          ],
          "name": { "ko": "표시 항목", "en": "Shows", "ja": "表示する項目", "zh": "显示项目" },
          "about": {
            "ko": "아이콘을 우클릭해도 메모리와 CPU가 바뀝니다",
            "en": "Right-clicking the icon also switches memory and CPU",
            "ja": "アイコンを右クリックしてもメモリと CPU が切り替わります",
            "zh": "右键单击图标也可在内存和 CPU 之间切换"
          },
          "easy": {
            "name": { "ko": "보일 값", "en": "Value shown", "ja": "表示する値", "zh": "显示的数值" },
            "about": {
              "ko": "아이콘을 오른쪽 클릭해도 바뀝니다",
              "en": "Right-clicking the icon changes it too",
              "ja": "アイコンを右クリックしても切り替わります",
              "zh": "右键单击图标也可以切换"
            }
          }
        },
        {
          "key": "widget.refreshSeconds",
          "type": "int",
          "default": 2,
          "min": 1,
          "max": 10,
          "name": { "ko": "새로 고침 간격(초)", "en": "Refresh interval (s)", "ja": "更新間隔 (s)", "zh": "刷新间隔 (s)" },
          "about": {
            "ko": "사용률을 다시 읽는 간격입니다",
            "en": "How often the memory use is read again",
            "ja": "メモリ使用率を読み直す間隔です",
            "zh": "重新读取内存使用率的间隔"
          },
          "easy": { "name": { "ko": "새로 고침 간격", "en": "Refresh every", "ja": "更新間隔", "zh": "刷新间隔" }, "about": "", "more": true }
        }
      ],
      "easy": { "name": { "ko": "작업표시줄 아이콘", "en": "Taskbar icon", "ja": "タスクバーのアイコン", "zh": "任务栏图标" } }
    },
    {
      "id": "clean",
      "name": { "ko": "정리할 곳", "en": "What to clean", "ja": "解放する場所", "zh": "清理范围" },
      "items": [
        {
          "key": "clean.areas",
          "type": "flags",
          "file": "prefs.json",
          "field": "areas",
          "default": 103,
          "min": 1,
          "options": [
            { "value": 1, "name": { "ko": "작업 집합", "en": "Working sets", "ja": "ワーキングセット", "zh": "工作集" } },
            { "value": 2, "name": { "ko": "시스템 파일 캐시", "en": "System file cache", "ja": "システムファイルキャッシュ", "zh": "系统文件缓存" } },
            { "value": 4, "name": { "ko": "낮은 우선순위 대기", "en": "Low-priority standby", "ja": "低優先度のスタンバイ", "zh": "低优先级备用" } },
            { "value": 32, "name": { "ko": "메모리 합치기", "en": "Combine memory", "ja": "メモリの結合", "zh": "合并内存" } },
            { "value": 64, "name": { "ko": "레지스트리 캐시", "en": "Registry cache", "ja": "レジストリキャッシュ", "zh": "注册表缓存" } },
            { "value": 8, "name": { "ko": "대기 목록 전체", "en": "Whole standby list", "ja": "スタンバイリスト全体", "zh": "整个备用列表" } },
            { "value": 16, "name": { "ko": "수정된 페이지", "en": "Modified pages", "ja": "変更されたページ", "zh": "已修改页面" } }
          ],
          "name": { "ko": "정리할 영역", "en": "Areas to clean", "ja": "解放する領域", "zh": "清理区域" },
          "about": {
            "ko": "지금 정리와 자동 정리에 씁니다. 대기 목록 전체와 수정된 페이지는 잠깐 멈칫할 수 있어 자동 정리에서는 빠집니다",
            "en": "Used by cleaning now and automatic cleaning. The whole standby list and modified pages may stall a moment, so automatic cleaning leaves them out.",
            "ja": "今すぐ解放と自動解放に使います。スタンバイリスト全体と変更されたページは一瞬止まることがあるため、自動解放では除きます。",
            "zh": "用于立即清理和自动清理。整个备用列表和已修改页面可能会短暂卡顿，因此自动清理不包括它们。"
          }
        }
      ],
      "easy": { "name": { "ko": "정리", "en": "Cleaning", "ja": "解放", "zh": "清理" } }
    },
    {
      "id": "auto",
      "name": { "ko": "자동 정리", "en": "Automatic cleaning", "ja": "自動解放", "zh": "自动清理" },
      "items": [
        {
          "key": "auto.percentOn",
          "type": "bool",
          "file": "prefs.json",
          "field": "autoPercentOn",
          "default": false,
          "name": { "ko": "사용률 기준 자동 정리", "en": "Clean above a memory use", "ja": "使用率による自動解放", "zh": "按使用率自动清理" },
          "about": {
            "ko": "사용률이 기준을 넘으면 정리합니다. 30초에 한 번까지입니다",
            "en": "Cleans when the memory use passes the limit, at most every 30 seconds.",
            "ja": "使用率が基準を超えると解放します。30 秒に 1 回までです。",
            "zh": "内存使用率超过阈值时清理，最多每 30 秒一次。"
          },
          "easy": {
            "name": { "ko": "메모리가 많이 차면 정리", "en": "Clean when memory fills up", "ja": "メモリが多く使われたら解放", "zh": "内存占用高时清理" },
            "about": { "ko": "30초에 한 번까지", "en": "At most once every 30 seconds", "ja": "30 秒に 1 回まで", "zh": "最多每 30 秒一次" },
            "thumb": {
              "shapes": [
                { "box": [6, 13, 48, 10], "r": 3, "alpha": 0.18 },
                { "box": [6, 13, 43, 10], "r": 3, "alpha": 0.45 },
                { "path": "M 49.2,9 V 27", "stroke": "accent", "width": 1.6 }
              ]
            }
          }
        },
        {
          "key": "auto.percent",
          "type": "int",
          "file": "prefs.json",
          "field": "autoPercent",
          "default": 90,
          "min": 50,
          "max": 99,
          "name": { "ko": "기준 사용률 (%)", "en": "Memory use limit (%)", "ja": "基準の使用率 (%)", "zh": "使用率阈值 (%)" },
          "easy": { "name": { "ko": "기준", "en": "At", "ja": "基準", "zh": "阈值" }, "when": { "key": "auto.percentOn" } }
        },
        {
          "key": "auto.intervalOn",
          "type": "bool",
          "file": "prefs.json",
          "field": "autoIntervalOn",
          "default": false,
          "name": { "ko": "일정 간격 자동 정리", "en": "Clean every so often", "ja": "一定間隔の自動解放", "zh": "定时自动清理" },
          "easy": {
            "name": { "ko": "정해진 시간마다 정리", "en": "Clean on a schedule", "ja": "決まった間隔で解放", "zh": "按固定间隔清理" },
            "about": "",
            "thumb": {
              "shapes": [
                { "dot": [20, 18, 11], "stroke": "ink", "alpha": 0.45 },
                { "path": "M 20,11 V 18 L 25,21", "stroke": "ink", "width": 1.3 },
                { "path": "M 36,18 H 50 M 46,14 L 50,18 46,22", "stroke": "ink", "width": 1.3 }
              ]
            }
          }
        },
        {
          "key": "auto.minutes",
          "type": "int",
          "file": "prefs.json",
          "field": "autoMinutes",
          "default": 30,
          "min": 1,
          "max": 1440,
          "name": { "ko": "정리 간격(분)", "en": "Interval (min)", "ja": "解放の間隔 (min)", "zh": "清理间隔 (min)" },
          "easy": {
            "name": { "ko": "간격", "en": "Every", "ja": "間隔", "zh": "间隔" },
            "when": { "key": "auto.intervalOn" },
            "minutes": true
          }
        }
      ]
    },
    {
      "id": "exclude",
      "name": { "ko": "예외 프로그램", "en": "Programs left alone", "ja": "除外するプログラム", "zh": "排除的程序" },
      "items": [
        {
          "key": "exclude.programs",
          "type": "list",
          "file": "prefs.json",
          "field": "exclude",
          "default": ["bloom.exe"],
          "max": 200,
          "suffix": ".exe",
          "name": { "ko": "예외 프로그램", "en": "Programs left alone", "ja": "除外するプログラム", "zh": "排除的程序" },
          "about": {
            "ko": "여기 둔 프로그램은 정리할 때 작업 집합을 비우지 않습니다",
            "en": "Programs listed here keep their working sets when memory is cleaned",
            "ja": "ここにあるプログラムは、解放のときにワーキングセットを空けません",
            "zh": "清理内存时不清空此处列出的程序的工作集"
          },
          "easy": { "name": { "ko": "프로그램", "en": "Program", "ja": "プログラム", "zh": "程序" } }
        }
      ],
      "easy": {
        "name": { "ko": "정리하지 않을 프로그램", "en": "Programs left alone", "ja": "解放しないプログラム", "zh": "不清理的程序" },
        "about": {
          "ko": "정리할 때 이 프로그램들의 메모리는 비우지 않습니다",
          "en": "Cleaning leaves these programs' memory as it is",
          "ja": "解放するとき、これらのプログラムのメモリは空けません",
          "zh": "清理时不释放这些程序的内存"
        }
      }
    },
    {
      "id": "pill",
      "name": { "ko": "모양", "en": "Look", "ja": "外観", "zh": "外观" },
      "items": [
        {
          "key": "pill.theme",
          "type": "choice",
          "default": "system",
          "options": [
            { "value": "system", "name": { "ko": "Windows 작업표시줄 테마", "en": "Windows taskbar theme", "ja": "Windows タスクバーのテーマ", "zh": "Windows 任务栏主题" } },
            { "value": "dark", "name": { "ko": "다크", "en": "Dark", "ja": "ダーク", "zh": "深色" } },
            { "value": "light", "name": { "ko": "라이트", "en": "Light", "ja": "ライト", "zh": "浅色" } }
          ],
          "name": { "ko": "테마", "en": "Theme", "ja": "テーマ", "zh": "主题" },
          "about": {
            "ko": "위젯과 창의 라이트·다크. Bloom 애드온으로 쓰면 Bloom의 테마를 따릅니다",
            "en": "Light or dark for the widget and its window. As a Bloom add-on it follows Bloom's theme",
            "ja": "ウィジェットとウィンドウのライト・ダーク。Bloom のアドオンとして使うと Bloom のテーマに従います",
            "zh": "小组件及其窗口的浅色或深色。作为 Bloom 加载项使用时跟随 Bloom 的主题"
          }
        },
        {
          "key": "pill.glass",
          "type": "bool",
          "default": true,
          "name": { "ko": "유리 효과", "en": "Glass effect", "ja": "ガラス効果", "zh": "玻璃效果" },
          "about": {
            "ko": "끄면 창이 블러 없이 테마 색으로 칠해집니다",
            "en": "When off, the window is filled in the theme's color without blur",
            "ja": "オフにするとウィンドウをぼかさずテーマの色で塗ります",
            "zh": "关闭后窗口不模糊，以主题颜色填充"
          }
        }
      ]
    }
  ],
